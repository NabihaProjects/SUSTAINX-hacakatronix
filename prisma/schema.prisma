// MILESTONE 14: SOIL TEST, BASELINE & VALIDATION
// ==========================================

model SoilTestReport {
  id                 String            @id @default(cuid())
  organizationId     String
  farmId             String
  fieldId            String
  sampleId           String?
  reportNumber       String            // e.g. "SR-2026-00412"
  laboratoryName     String            // e.g. "National Ag Analytical Labs"
  collectionDate     DateTime
  testDate           DateTime
  receivedDate       DateTime          @default(now())
  uploadedByUserId   String?
  source             String            @default("LAB_SOIL_TEST") // LAB_SOIL_TEST, GOVERNMENT_SOIL_REPORT, FIELD_SENSOR, FARMER_ENTRY, IMPORTED_DATA, ESTIMATED, SIMULATION
  status             String            @default("VALIDATED") // DRAFT, IMPORTED, VALIDATED, REJECTED, ARCHIVED
  notes              String?
  documentReference  String?           // Reference to scanned PDF / lab cert
  version            String            @default("v1.0")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  samples            SoilSample[]

  @@unique([organizationId, reportNumber])
  @@index([organizationId])
  @@index([fieldId])
  @@index([status])
}

model SoilSample {
  id                 String            @id @default(cuid())
  organizationId     String
  farmId             String
  fieldId            String
  gridId             String?
  reportId           String?
  sampleCode         String            // e.g. "SMP-F03-G047-01"
  latitude           Float?
  longitude          Float?
  collectionDate     DateTime
  depthCm            Float             @default(15.0) // Sampling depth in cm (e.g. 0-15cm, 15-30cm)
  samplingMethod     String            @default("CORE_COMPOSITE") // CORE_COMPOSITE, AUGER, BULK_SURFACE
  source             String            @default("LAB_SOIL_TEST")
  notes              String?
  createdAt          DateTime          @default(now())

  report             SoilTestReport?   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  measurements       SoilLabMeasurement[]

  @@unique([organizationId, sampleCode])
  @@index([organizationId])
  @@index([gridId])
  @@index([fieldId])
}

model SoilLabMeasurement {
  id                 String            @id @default(cuid())
  sampleId           String
  nutrientCode       String            // N, P, K, pH, EC, organicCarbon, S, Zn, Fe, Mn, B
  value              Float
  unit               String            // mg/kg, ppm, kg/ha, %, pH, dS/m
  method             String?           // e.g. "Bray-1", "Olsen P", "Kjeldahl N", "Ammonium Acetate"
  source             String            @default("LAB_SOIL_TEST")
  confidence         Float             @default(0.95) // 0.0 - 1.0
  quality            String            @default("HIGH") // HIGH, MEDIUM, LOW, INVALID
  measuredAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())

  sample             SoilSample        @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([sampleId])
  @@index([nutrientCode])
  @@index([quality])
}

