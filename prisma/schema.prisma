  id                 String            @id @default(cuid())
  code               String            @unique // N, P, K, S, Zn, Fe, Mn, B, pH, EC, OC
  name               String            // Nitrogen, Phosphorus, Potassium, etc.
  symbol             String
  standardUnit       String            // mg/kg, %, pH, dS/m
  category           String            // MACRO, MICRO, SECONDARY, CHEMICAL, PHYSICAL
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
}

model FieldSoilBaseline {
  id                 String            @id @default(cuid())
  organizationId     String
  farmId             String
  fieldId            String
  gridId             String?           // Nullable for whole field baseline, set for grid baseline
  reportId           String?
  effectiveDate      DateTime          @default(now())
  source             String            @default("LAB_SOIL_TEST") // LAB_SOIL_TEST, IMPORTED_DATA, SENSOR_ESTIMATE, FARMER_ENTRY, SIMULATION
  
  // Primary nutrients (normalized kg/ha or standard units)
  nValue             Float             // Nitrogen baseline (kg/ha)
  pValue             Float             // Phosphorus baseline (kg/ha)
  kValue             Float             // Potassium baseline (kg/ha)
  phValue            Float?            // Soil pH (e.g. 6.4)
  ecValue            Float?            // EC in dS/m (e.g. 1.2)
  ocValue            Float?            // Organic carbon % (e.g. 0.85%)
  otherNutrientsJson String?           // Additional micronutrients (Zn, Fe, S, B)

  confidenceScore    Float             @default(0.90) // 0.0 - 1.0
  quality            String            @default("HIGH") // HIGH, MEDIUM, LOW
  version            String            @default("v1") // v1, v2, v3
  status             String            @default("ACTIVE") // DRAFT, REVIEW, APPROVED, ACTIVE, SUPERSEDED
  approvedByUserId   String?
  approvedAt         DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId])
  @@index([fieldId])
  @@index([gridId])
  @@index([status])
}

