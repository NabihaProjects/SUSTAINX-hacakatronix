  pilotId            String
  category           String            // soil, fertilizer, weather, application, cost, yield, crop_condition, sensor_health
  frequency          String            // daily, continuous, pre_post, harvest, weekly
  source             String            // LAB_SOIL_TEST, FIELD_SENSOR, SPRAYER_TELEMETRY, MANUAL_OBSERVATION, SCALE_WEIGHT
  unit               String            // kg/ha, %, dS/m, USD/ha, bu/acre
  responsibleParty   String            // Agronomist, Machine Operator, Edge Gateway
  recordsExpected    Int               @default(100)
  recordsCollected   Int               @default(0)
  qualityStatus      String            @default("HIGH") // HIGH, MEDIUM, LOW, INCOMPLETE
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  pilot              PilotProject      @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
  @@index([category])
}

model AgronomicReviewItem {
  id                 String            @id @default(cuid())
  organizationId     String
  targetType         String            // SOIL_BASELINE, PRESCRIPTION, ANOMALY, DATA_CONFLICT, SAMPLING_REC
  targetId           String            // ID of baseline, prescription, or grid
  issueTitle         String
  evidenceJson       String            // Evidence payload: lab test values, sensor data, difference pct
  recommendationText String
  confidenceScore    Float             @default(0.65)
  status             String            @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_MORE_DATA
  reviewerId         String?
  decisionNotes      String?
  createdAt          DateTime          @default(now())
  reviewedAt         DateTime?

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([targetType])
}

model KnowledgeSource {
  id                 String            @id @default(cuid())
  title              String
  publisher          String
  url                String?
  documentReference  String?
  publicationDate    DateTime?
  sourceType         String            @default("RESEARCH") // GOVERNMENT, RESEARCH, UNIVERSITY, MANUFACTURER, INTERNAL, OTHER
  notes              String?
  createdAt          DateTime          @default(now())

  articles           KnowledgeArticle[]
}

model KnowledgeArticle {
  id                 String            @id @default(cuid())
  category           String            // SOIL, FERTILIZER, CROPS, SENSORS, MACHINES, ENVIRONMENT, SOIL_IQ, OPERATIONS
  title              String
  summary            String
  content            String
  sourceId           String?
  version            String            @default("1.0")
  lastReviewedAt     DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  source             KnowledgeSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([category])
}

model SupportTicket {
  id                 String            @id @default(cuid())
  organizationId     String
  userId             String?
  category           String            @default("OPERATIONAL") // HARDWARE, SENSOR, PRESCRIPTION, BILLING, GENERAL
  priority           String            @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  farmId             String?
  deviceId           String?
  title              String
  description        String
  status             String            @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  resolutionNotes    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model CustomerApiKey {
  id                 String            @id @default(cuid())
  organizationId     String
  name               String
  keyHash            String            // SHA-256 hashed secret token
  keyPrefix          String            // First 8 chars e.g. "siq_live_abc123"
  scopesJson         String            // Array of scopes: READ_FARMS, READ_FIELDS, READ_GRIDS, READ_SOIL, etc.
  status             String            @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  createdByUserId    String?
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
  @@index([status])
}

model DeploymentChecklist {
  id                 String            @id @default(cuid())
  organizationId     String
  fieldId            String?
  sprayerId          String?
  itemsJson          String            // 13 checklist verification items with status PENDING/PASSED/FAILED
  readinessScore     Int               @default(0) // 0 - 100
  status             String            @default("NOT_READY") // READY, NOT_READY
  lastInspectedAt    DateTime          @default(now())
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

